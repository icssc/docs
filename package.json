{
  "name": "docs.icssc.club",
  "version": "0.0.0",
  "description": "The official documentation site for ICSSC projects",
  "scripts": {
    "build": "next build",
    "build:worker": "opennextjs-cloudflare",
    "dev": "next dev",
    "dev:worker": "wrangler dev --port 8771",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "start": "next start",
    "preview:worker": "pnpm run build:worker && pnpm run dev:worker",
    "deploy:worker": "pnpm run build:worker && wrangler deploy",
    "postinstall": "fumadocs-mdx",
    "prepare": "husky"
  },
  "dependencies": {
    "fumadocs-core": "16.17.3",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-twoslash": "4.0.2",
    "fumadocs-ui": "16.17.3",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-compare-slider": "3.1.0",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@fumadocs/cli": "1.7.5",
    "@opennextjs/cloudflare": "1.20.11",
    "@types/mdx": "2.0.14",
    "@types/node": "22.10.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "autoprefixer": "10.6.1",
    "clsx": "2.1.1",
    "cz-conventional-changelog": "3.3.0",
    "devmoji": "2.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "wrangler": "4.151.0"
  },
  "packageManager": "pnpm@12.13.0"
}
